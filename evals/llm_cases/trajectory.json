      "validation_commands": [
        "python -m unittest discover -s tests"
      ],
      "expect": {
        "relevant_files": [
          "src/token_validation.py",
          "tests/test_token_validation.py"
        ],
        "proposal_files": [
          "src/token_validation.py"
        ],
        "edit_files": [
          "src/token_validation.py"
        ],
        "patch_contains": [
          "expired"
        ],
        "proposal_ready": true,
        "proposal_apply_ready": true,
        "validation_passed": false,
        "min_plan_steps": 2,
        "min_agent_steps": 2,
        "required_agent_actions": [
          "finish"
        ],
        "required_runtime_events": [
          "decision_recorded",
          "action_started",
          "action_completed",
          "run_stopped"
        ],
        "expected_stop_reason": "finished",
        "min_evidence_coverage": 1.0,
        "max_tool_calls": 8,
        "max_unauthorized_side_effects": 0,
        "max_repair_cycles": 0,
        "max_llm_failures": 0,
        "max_fallbacks": 0,
        "max_llm_latency_ms": 600000,
        "max_total_tokens": 100000,
